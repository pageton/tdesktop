using "chat_helpers/chat_helpers.style";

historyMathHintSkip: 4px;
historyMathHint: RoundButton(defaultActiveButton) {
	width: -16px;
	height: 24px;
	radius: 12px;
	textTop: 4px;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
